# ClearFund environment configuration
# Never commit wallet secrets, private keys, or .env files.
# Production uses Arc Mainnet (chain ID 5042).
VITE_CLEARFUND_CHAIN=mainnet

# REQUIRED before enabling onchain transactions: verified Arc Mainnet escrow deployment.
# Do not reuse the historical Arc Testnet contract address.
VITE_CLEARFUND_ESCROW_ADDRESS=
VITE_CLEARFUND_DEPLOY_BLOCK=

# Optional Arc Studio proxy; leave blank outside its environment.
VITE_RPC_PROXY_BASE_URL=
VITE_RPC_PROXY_CHAINS=
VITE_RPC_PROXY_TOKEN=
