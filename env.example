# ClearFund — environment variable template
# Copy this file to .env and fill in the values.
# NEVER commit .env to version control.

# ── Onchain configuration (Arc Testnet) ─────────────────────────────────────
# Set these after deploying ClearFundEscrow.sol to Arc Testnet.
# While unset, the app runs in DEMO mode (localStorage only, no wallet required).

# Deployed contract address — Arc Testnet deployment (verified 2026-10-19)
VITE_CLEARFUND_ESCROW_ADDRESS=0x3cfce9ad713a72ecd0a9f1199664fea8b4de209e

# Block number at which the contract was deployed (used by the event indexer as start block)
VITE_CLEARFUND_DEPLOY_BLOCK=68143548

# ── RPC proxy (Arc Studio managed — do not edit manually) ───────────────────
# These are injected by Arc Studio when the sandbox starts.
# Leave them blank in your own deployment and the app will fall back to the
# public Arc Testnet RPC endpoint from @/onchain-facts.
VITE_RPC_PROXY_BASE_URL=
VITE_RPC_PROXY_CHAINS=
VITE_RPC_PROXY_TOKEN=
